--- a/drivers/net/wireless/mediatek/mt76/mt7921/pci_mac.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/pci_mac.c
@@ -16,6 +16,8 @@
 	struct mt76_connac_hw_txp *txp;
 	struct mt76_txwi_cache *t;
 	int id, pid;
+	bool injected_legacy = false;
+	u16 injected_rate = 0;
 	u8 *txwi = (u8 *)txwi_ptr;
 
 	if (unlikely(tx_info->skb->len <= ETH_HLEN))
@@ -40,10 +42,44 @@
 		}
 	}
 
+	/* Save the rate before TX status bookkeeping clears control.flags. */
+	if (is_mt7922(mdev) &&
+	    !(info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP) &&
+	    (info->flags & IEEE80211_TX_CTL_INJECTED) &&
+	    (info->control.flags & IEEE80211_TX_CTRL_RATE_INJECT) &&
+	    !(info->control.rates[0].flags &
+	      (IEEE80211_TX_RC_MCS | IEEE80211_TX_RC_VHT_MCS)) &&
+	    info->band < NUM_NL80211_BANDS) {
+		struct ieee80211_supported_band *sband;
+		int idx = info->control.rates[0].idx;
+
+		sband = mdev->phy.hw->wiphy->bands[info->band];
+		if (sband && idx >= 0 && idx < sband->n_bitrates) {
+			struct ieee80211_rate *r = &sband->bitrates[idx];
+			u16 hw_rate = r->hw_value;
+
+			if (info->control.rates[0].flags & IEEE80211_TX_RC_USE_SHORT_PREAMBLE)
+				hw_rate = r->hw_value_short;
+			injected_rate = FIELD_PREP(MT_TX_RATE_MODE, hw_rate >> 8) |
+					FIELD_PREP(MT_TX_RATE_IDX, hw_rate & 0xff);
+			injected_legacy = true;
+		}
+	}
+
 	pid = mt76_tx_status_skb_add(mdev, wcid, tx_info->skb);
 	mt76_connac2_mac_write_txwi(mdev, txwi_ptr, tx_info->skb, wcid, key,
 				    pid, qid, 0);
 
+	if (injected_legacy) {
+		__le32 *txd = txwi_ptr;
+
+		txd[2] |= cpu_to_le32(MT_TXD2_FIX_RATE | MT_TXD2_HTC_VLD);
+		txd[3] |= cpu_to_le32(MT_TXD3_BA_DISABLE);
+		txd[6] = cpu_to_le32(MT_TXD6_FIXED_BW |
+				     FIELD_PREP(MT_TXD6_TX_RATE, injected_rate));
+		txd[7] &= ~cpu_to_le32(MT_TXD7_HW_AMSDU);
+	}
+
 	txp = (struct mt76_connac_hw_txp *)(txwi + MT_TXD_SIZE);
 	memset(txp, 0, sizeof(struct mt76_connac_hw_txp));
 	mt76_connac_write_hw_txp(mdev, tx_info, txp, id);
--- a/drivers/net/wireless/mediatek/mt76/mt7921/pci.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/pci.c
